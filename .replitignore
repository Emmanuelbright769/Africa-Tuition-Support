# Exclude large directories not needed at runtime so the Repl layer stays
# well under Cloudflare's blob upload limit.

# Dependencies — reinstalled by npm install during the build step
node_modules/

# Agent chat uploads (user screenshots shared with the AI assistant)
attached_assets/

# Replit internal skills & MCP data — never referenced by the app
.local/

# Agent memory & task files
.agents/

# Local development screenshots
screenshots/

# npm/tool cache — not needed at runtime
.cache/

# Mockup sandbox (design tool only, not the production app)
artifacts/
